<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartcity.controller.CitizenDashboardController"
            prefWidth="1200" prefHeight="700"
            minWidth="960" minHeight="600"
            stylesheets="@../css/design-system.css"
            styleClass="app-root">

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         HEADER CITOYEN (vert)
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="header-citizen">
            <padding><Insets left="20" right="20"/></padding>
            <StackPane styleClass="header-logo-badge header-logo-badge-citizen" alignment="CENTER">
                <Label text="SC" styleClass="header-logo-text"/>
            </StackPane>
            <Label text="SmartCity" styleClass="header-brand"/>
            <Label text="/" styleClass="header-sep"/>
            <Label text="Espace Citoyen" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane styleClass="header-avatar" alignment="CENTER">
                <Label fx:id="citizenAvatarLabel" text="C" styleClass="header-avatar-text"/>
            </StackPane>
            <Label fx:id="citizenNameLabel" styleClass="header-user" text=""/>
            <Button fx:id="themeToggleButton" text="Mode Sombre" onAction="#handleToggleTheme" styleClass="theme-toggle-button"/>
            <Button text="DÃ©connexion" onAction="#handleDeconnexion" styleClass="logout-button"/>
        </HBox>
    </top>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         SIDEBAR CITOYEN
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="4" minHeight="600">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>

            <Label text="NAVIGATION" styleClass="sidebar-section-label"/>
            <Button fx:id="btnCitizenDashboard" text="ðŸ  Tableau de bord" styleClass="sidebar-button, sidebar-button-active" onAction="#handleShowCitizenDashboard"/>

            <Region prefHeight="8"/>
            <Label text="MES SIGNALEMENTS" styleClass="sidebar-section-label"/>
            <Button fx:id="btnAjouterSignalement" text="âž• Nouveau signalement" styleClass="sidebar-button" onAction="#handleShowAjouterSignalement"/>
            <StackPane>
                <Button fx:id="btnMesSignalements" text="ðŸ“‹ Mes signalements" styleClass="sidebar-button" onAction="#handleShowMesSignalements" maxWidth="Infinity"/>
                <Label fx:id="badgeSignalements" text="" styleClass="notification-badge"
                       visible="false" managed="false"
                       StackPane.alignment="TOP_RIGHT"
                       style="-fx-background-color:#E53935;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:1 5 1 5;-fx-translate-x:-4;-fx-translate-y:4;"/>
            </StackPane>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="COMPTE" styleClass="sidebar-section-label"/>
            <Button fx:id="btnMonProfil" text="ðŸ‘¤ Mon profil" styleClass="sidebar-button" onAction="#handleShowMonProfil"/> 
        </VBox>
    </left>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         CONTENU
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <center>
        <VBox styleClass="content-root" spacing="12">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <!-- Message flottant -->
            <Label fx:id="citizenMessageLabel" text="" styleClass="floating-message" visible="false" managed="false"/>

            <StackPane VBox.vgrow="ALWAYS">

                <!-- â”€â”€â”€ PAGE DASHBOARD CITOYEN â”€â”€â”€ -->
                <ScrollPane fx:id="pageCitizenDashboard" fitToWidth="true" styleClass="dash-scroll">
                <VBox spacing="24" styleClass="page-box" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="3">
                            <Label text="Tableau de bord" styleClass="page-title"/>
                            <Label text="Suivez l'Ã©tat de vos signalements" styleClass="page-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Actualiser" onAction="#chargerDonnees" styleClass="btn-outline-sm">
                            <tooltip><Tooltip text="Raccourci : F5"/></tooltip>
                        </Button>
                        <Button text="Nouveau signalement" onAction="#handleShowAjouterSignalement" styleClass="action-button"/>
                    </HBox>

                    <!-- Cards citoyen -->
                    <HBox spacing="16">
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="130">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="stat-card-icon-bg stat-card-icon-blue" alignment="CENTER">
                                    <Label text="ðŸ“‹" style="-fx-font-size:18px;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label fx:id="citizenCardTotal" text="0" styleClass="stat-card-number"/>
                                    <Label text="Total signalements" styleClass="stat-card-label"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="130">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="stat-card-icon-bg stat-card-icon-orange" alignment="CENTER">
                                    <Label text="â³" style="-fx-font-size:18px;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label fx:id="citizenCardAttente" text="0" styleClass="stat-card-number"/>
                                    <Label text="En attente" styleClass="stat-card-label"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="130">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="stat-card-icon-bg stat-card-icon-purple" alignment="CENTER">
                                    <Label text="ðŸ”„" style="-fx-font-size:18px;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label fx:id="citizenCardEnCours" text="0" styleClass="stat-card-number"/>
                                    <Label text="En cours de traitement" styleClass="stat-card-label"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="130">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane styleClass="stat-card-icon-bg stat-card-icon-green" alignment="CENTER">
                                    <Label text="âœ…" style="-fx-font-size:18px;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label fx:id="citizenCardCollectes" text="0" styleClass="stat-card-number"/>
                                    <Label text="TerminÃ©s" styleClass="stat-card-label"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Graphique + CTA -->
                    <HBox spacing="20" VBox.vgrow="ALWAYS">
                        <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="10">
                            <Label text="RÃ©partition de mes signalements" styleClass="chart-card-title"/>
                            <PieChart fx:id="citizenPieChart" prefHeight="260" VBox.vgrow="ALWAYS"/>
                        </VBox>
                        <!-- Encart CTA -->
                        <VBox styleClass="cta-card" prefWidth="200" spacing="16" alignment="CENTER">
                            <Label text="ðŸŒ" style="-fx-font-size:40px;"/>
                            <Label text="Contribuez Ã  une ville plus propre" styleClass="cta-card-title" wrapText="true" textAlignment="CENTER"/>
                            <Label text="Signalez les dÃ©pÃ´ts sauvages dans votre quartier et aidez les agents Ã  intervenir rapidement." styleClass="cta-card-desc" wrapText="true" textAlignment="CENTER"/>
                        <Button text="Nouveau signalement" prefHeight="40" onAction="#handleShowAjouterSignalement" styleClass="action-button" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>
                </ScrollPane>

                <!-- â”€â”€â”€ PAGE AJOUTER SIGNALEMENT â”€â”€â”€ -->
                <ScrollPane fx:id="pageAjouterSignalement" fitToWidth="true" styleClass="dash-scroll" visible="false" managed="false">
                    <VBox spacing="24" styleClass="page-box" alignment="TOP_CENTER">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="3">
                                <Label text="Nouveau Signalement" styleClass="page-title"/>
                                <Label text="Renseignez les informations du dÃ©pÃ´t sauvage" styleClass="page-subtitle"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="24" VBox.vgrow="ALWAYS">
                            <!-- Formulaire gauche -->
                            <VBox spacing="16" HBox.hgrow="ALWAYS" maxWidth="420">

                                <VBox spacing="6">
                                    <Label text="Description" styleClass="auth-field-label"/>
                                    <TextArea fx:id="descriptionSignalementArea"
                                              prefHeight="110" wrapText="true"
                                              promptText="DÃ©crivez le type et l'Ã©tat du dÃ©pÃ´t..."
                                              styleClass="dash-textarea"/>
                                </VBox>

                                <HBox spacing="14">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="CatÃ©gorie" styleClass="auth-field-label"/>
                                        <ComboBox fx:id="categorieSignalementCombo" prefHeight="44" maxWidth="Infinity" styleClass="dash-combo"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Zone" styleClass="auth-field-label"/>
                                        <ComboBox fx:id="zoneSignalementCombo" prefHeight="44" maxWidth="Infinity" styleClass="dash-combo"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="6">
                                    <Label text="Photo (optionnel)" styleClass="auth-field-label"/>
                                    <HBox spacing="10">
                                        <TextField fx:id="photoSignalementField" prefHeight="44" HBox.hgrow="ALWAYS" styleClass="dash-field" promptText="Chemin vers la photo..."/>
                                        <Button text="ðŸ“· Choisir" prefHeight="44" onAction="#handleChoisirPhoto" styleClass="btn-outline-sm"/>
                                    </HBox>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="Position GPS" styleClass="auth-field-label"/>
                                    <HBox styleClass="position-indicator" alignment="CENTER_LEFT" spacing="10">
                                        <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                                        <Label text="ðŸ“" style="-fx-font-size:16px;"/>
                                        <Label fx:id="positionLabel" text="Cliquez sur la carte pour placer le marqueur" styleClass="position-indicator-text" wrapText="true"/>
                                    </HBox>
                                </VBox>

                                <HBox spacing="12">
                            <Button text="Enregistrer" prefHeight="40" onAction="#handleEnregistrerSignalement" styleClass="action-button" HBox.hgrow="ALWAYS"/>
                                    <Button text="Annuler" prefHeight="40" onAction="#handleAnnulerSignalement" styleClass="btn-outline-sm"/>
                                </HBox>
                            </VBox>

                            <!-- Carte interactive pour placer le signalement -->
                            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="stat-card" minWidth="340">
                                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="ðŸ“ Cliquez sur la carte pour localiser le dÃ©chet" styleClass="page-subtitle"
                                           style="-fx-font-size:13px;-fx-font-weight:bold;" wrapText="true"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnRecentrerCarte" text="âŸ³ Recentrer" onAction="#handleRecentrerCarte" styleClass="btn-outline-sm"/>
                                </HBox>
                                <javafx.scene.web.WebView fx:id="signalementMapView" prefHeight="320" VBox.vgrow="ALWAYS"/>
                                <HBox alignment="CENTER" spacing="10"
                                      style="-fx-background-color:#f0fdf4;-fx-background-radius:10;-fx-padding:10 16;">
                                    <Label fx:id="gpsReceivedIcon" text="â³" style="-fx-font-size:18px;"/>
                                    <Label fx:id="gpsPositionStatusLabel"
                                           text="Cliquez sur la carte pour placer le marqueur"
                                           styleClass="position-indicator-text" wrapText="true"/>
                                </HBox>

                                <!-- QR Code & Lien GPS (fallback tÃ©lÃ©phone) -->
                                <Region prefHeight="14"/>
                                <VBox spacing="10" alignment="CENTER" style="-fx-background-color:#f8fafc;-fx-background-radius:10;-fx-padding:14 16;">
                                    <Label fx:id="gpsStatusLabel" text="ðŸ“± Ou scannez le QR code (mÃªme WiFi requis)" styleClass="page-subtitle" style="-fx-font-size:12px;-fx-font-weight:bold;" wrapText="true" textAlignment="CENTER"/>
                                    
                                    <!-- QR Code Image -->
                                    <HBox alignment="CENTER">
                                        <ImageView fx:id="citizenQrCodeView" fitHeight="140" fitWidth="140" preserveRatio="true"
                                                   style="-fx-border-color:#e2e8f0;-fx-border-width:2;-fx-border-radius:8;"/>
                                    </HBox>
                                    
                                    <!-- Lien cliquable + copier -->
                                    <Label text="Lien GPS:" styleClass="auth-field-label" style="-fx-font-size:11px;"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label fx:id="citizenGpsUrlLabel" text="http://localhost:8081/gps/" styleClass="auth-link" 
                                               style="-fx-font-size:11px; -fx-text-fill:#0f766e; -fx-underline:true;"/>
                                        <Button text="ðŸ“‹ Copier" prefHeight="28" onAction="#handleCopyGpsLink" styleClass="btn-outline-sm" style="-fx-font-size:11px;"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <!-- â”€â”€â”€ PAGE MES SIGNALEMENTS â”€â”€â”€ -->
                <ScrollPane fx:id="pageMesSignalements" fitToWidth="true" styleClass="dash-scroll" visible="false" managed="false">
                <VBox spacing="20" styleClass="page-box" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="3">
                            <Label text="Mes Signalements" styleClass="page-title"/>
                            <Label text="Historique de tous vos signalements" styleClass="page-subtitle"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Statut :" styleClass="filter-bar-label"/>
                        <ComboBox fx:id="filterMesSignalementsStatut" prefWidth="160" prefHeight="36" promptText="Tous les statuts" styleClass="dash-combo"/>
                        <Label text="Date :" styleClass="filter-bar-label"/>
                        <javafx.scene.control.DatePicker fx:id="filterMesSignalementsDate" prefWidth="160" prefHeight="36" promptText="Date" styleClass="dash-datepicker"/>
                        <Button text="Filtrer" prefHeight="36" onAction="#handleFiltrerMesSignalements" styleClass="btn-outline-sm"/>
                        <Button text="RÃ©initialiser" prefHeight="36" onAction="#handleResetFiltresMesSignalements" styleClass="btn-outline-sm"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSupprimerSignalement" text="Supprimer" onAction="#handleSupprimerSignalement" styleClass="danger-button">
                            <tooltip><Tooltip text="Supprimer le signalement selectionne"/></tooltip>
                        </Button>
                    </HBox>
                    <TableView fx:id="tableMesSignalements" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colMesId" text="ID" prefWidth="65"/>
                            <TableColumn fx:id="colMesDescription" text="Description" prefWidth="260"/>
                            <TableColumn fx:id="colMesCategorie" text="CatÃ©gorie" prefWidth="150"/>
                            <TableColumn fx:id="colMesZone" text="Zone" prefWidth="140"/>
                            <TableColumn fx:id="colMesDate" text="Date" prefWidth="160"/>
                            <TableColumn fx:id="colMesStatut" text="Statut" prefWidth="140"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10">
                                <Label text="ðŸ“­" style="-fx-font-size:36px;"/>
                                <Label text="Aucun signalement pour le moment" styleClass="empty-state-title"/>
                                <Label text="CrÃ©ez votre premier signalement" styleClass="empty-state-desc"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
                </ScrollPane>

                <!-- â”€â”€â”€ PAGE PROFIL CITOYEN â”€â”€â”€ -->
                <ScrollPane fx:id="pageMonProfil" fitToWidth="true" styleClass="dash-scroll" visible="false" managed="false">
                <VBox spacing="24" styleClass="page-box" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
                    <Label text="Mon Profil" styleClass="page-title"/>
                    <Label text="GÃ©rez vos informations personnelles" styleClass="page-subtitle"/>

                    <VBox styleClass="profile-card" maxWidth="520" spacing="20">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <StackPane styleClass="profile-avatar-lg" alignment="CENTER">
                                <Label fx:id="citizenProfilAvatarLabel" text="C" styleClass="profile-avatar-lg-text"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="citizenProfilNomDisplay" text="Citoyen" styleClass="profile-name-display"/>
                                <Label text="Citoyen" styleClass="profile-role-badge-citizen"/>
                            </VBox>
                        </HBox>

                        <Region styleClass="profile-divider" prefHeight="1"/>

                        <VBox spacing="6">
                            <Label text="Nom complet" styleClass="auth-field-label"/>
                            <TextField fx:id="profilNomField" styleClass="dash-field"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Adresse email" styleClass="auth-field-label"/>
                            <TextField fx:id="profilEmailField" styleClass="dash-field"/>
                        </VBox>
                        <HBox spacing="14">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Zone" styleClass="auth-field-label"/>
                                <ComboBox fx:id="profilZoneCombo" prefHeight="44" maxWidth="Infinity" styleClass="dash-combo"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="TÃ©lÃ©phone" styleClass="auth-field-label"/>
                                <TextField fx:id="profilTelephoneField" styleClass="dash-field"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="12">
                            <Button text="Enregistrer" prefHeight="40" onAction="#handleModifierProfil" styleClass="action-button" HBox.hgrow="ALWAYS"/>
                            <Button text="Mot de passe" prefHeight="40" onAction="#handleModifierMotPasse" styleClass="btn-outline-sm"/>
                        </HBox>
                        <Region prefHeight="16"/>
                        <VBox styleClass="danger-zone-section" spacing="8">
                            <Label text="Zone dangereuse" styleClass="danger-zone-title"/>
                            <Label text="Cette action est irreversible. Votre compte et vos donnees seront supprimes." wrapText="true" styleClass="danger-zone-desc"/>
                            <Button text="Supprimer mon compte" prefHeight="40" onAction="#handleSupprimerCompte" styleClass="danger-button" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                </VBox>
                </ScrollPane>

            </StackPane>
        </VBox>
    </center>

</BorderPane>



