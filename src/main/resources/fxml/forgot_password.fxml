<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartcity.controller.ForgotPasswordController"
      prefWidth="1040" prefHeight="640"
      minWidth="760" minHeight="540"
      stylesheets="@../css/design-system.css"
      styleClass="auth-root-split">

    <!-- PANNEAU GAUCHE — Branding -->
    <StackPane prefWidth="420" minWidth="320" maxWidth="440">
        <VBox styleClass="auth-brand-panel" alignment="CENTER" spacing="0"/>
        <StackPane styleClass="auth-deco-circle-1" alignment="CENTER"/>
        <StackPane styleClass="auth-deco-circle-2" alignment="CENTER"/>
        <StackPane styleClass="auth-deco-circle-3" alignment="CENTER"/>

        <VBox alignment="CENTER" spacing="0">
            <VBox alignment="CENTER" spacing="0" VBox.vgrow="ALWAYS">
                <padding><Insets top="72" right="48" bottom="0" left="48"/></padding>

                <StackPane fx:id="logoPane" alignment="CENTER">
                    <StackPane styleClass="auth-logo-ring-outer" alignment="CENTER">
                        <StackPane styleClass="auth-logo-ring-inner" alignment="CENTER">
                            <ImageView fitWidth="96" fitHeight="96" preserveRatio="true" smooth="true">
                                <image><Image url="@../images/EcoTrack.png"/></image>
                            </ImageView>
                        </StackPane>
                    </StackPane>
                </StackPane>

                <Region prefHeight="28"/>

                <VBox fx:id="brandTitleBox" alignment="CENTER" spacing="8">
                    <Label text="SmartCity" styleClass="auth-brand-title"/>
                    <Label text="Récupération de compte" styleClass="auth-brand-subtitle"/>
                </VBox>

                <Region prefHeight="28"/>
                <StackPane fx:id="brandDivider" prefHeight="1" maxWidth="40"
                           styleClass="auth-brand-divider" alignment="CENTER"/>
                <Region prefHeight="32"/>

                <VBox fx:id="infoBox" spacing="16" alignment="CENTER_LEFT" maxWidth="280">
                    <Label text="Comment ça marche ?" styleClass="auth-feature-title"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size:14px;"/>
                    <VBox spacing="12">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="1" style="-fx-background-color:rgba(255,255,255,0.2);-fx-background-radius:20;-fx-pref-width:28;-fx-pref-height:28;-fx-alignment:center;-fx-text-fill:white;-fx-font-weight:bold;"/>
                            <Label text="Saisissez votre adresse email" styleClass="auth-feature-desc"
                                   style="-fx-text-fill:rgba(255,255,255,0.75);"/>
                        </HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="2" style="-fx-background-color:rgba(255,255,255,0.2);-fx-background-radius:20;-fx-pref-width:28;-fx-pref-height:28;-fx-alignment:center;-fx-text-fill:white;-fx-font-weight:bold;"/>
                            <Label text="Contactez support@smartcity.sn" styleClass="auth-feature-desc"
                                   style="-fx-text-fill:rgba(255,255,255,0.75);"/>
                        </HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="3" style="-fx-background-color:rgba(255,255,255,0.2);-fx-background-radius:20;-fx-pref-width:28;-fx-pref-height:28;-fx-alignment:center;-fx-text-fill:white;-fx-font-weight:bold;"/>
                            <Label text="Un administrateur réinitialisera votre mot de passe" styleClass="auth-feature-desc"
                                   wrapText="true" style="-fx-text-fill:rgba(255,255,255,0.75);"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>

            <VBox fx:id="brandFooter" alignment="CENTER">
                <padding><Insets top="0" bottom="32"/></padding>
                <Label text="© 2026 SmartCity — Pikine &amp; Guédiawaye, Sénégal" styleClass="auth-brand-footer"/>
            </VBox>
        </VBox>
    </StackPane>

    <!-- PANNEAU DROIT — Formulaire -->
    <VBox styleClass="auth-form-panel" HBox.hgrow="ALWAYS" alignment="CENTER">
        <VBox alignment="TOP_LEFT" spacing="0" maxWidth="400">
            <padding><Insets left="48" right="48"/></padding>

            <Label fx:id="formTitle" text="Mot de passe oublié" styleClass="auth-form-title"/>
            <Region prefHeight="10"/>
            <Label fx:id="formSubtitle"
                   text="Saisissez votre email pour recevoir les instructions"
                   styleClass="auth-form-subtitle" wrapText="true"/>
            <Region prefHeight="40"/>

            <VBox fx:id="emailGroup" spacing="0">
                <Label text="Adresse email" styleClass="auth-field-label"/>
                <Region prefHeight="10"/>
                <TextField fx:id="emailField"
                           promptText="exemple@email.com"
                           maxWidth="Infinity" prefHeight="52"
                           styleClass="auth-field"/>
                <Label fx:id="emailErrorLabel" text="" styleClass="auth-inline-error"
                       visible="false" managed="false"/>
            </VBox>
            <Region prefHeight="32"/>

            <Button fx:id="submitButton"
                    text="ENVOYER LES INSTRUCTIONS"
                    maxWidth="Infinity" prefHeight="52"
                    onAction="#handleSubmit"
                    styleClass="auth-submit-btn"/>

            <Region prefHeight="28"/>

            <HBox fx:id="backLinkBox" alignment="CENTER" spacing="6">
                <Label text="Vous vous souvenez ?" styleClass="auth-hint-label"/>
                <Hyperlink fx:id="backToLoginLink" text="← Retour à la connexion" styleClass="auth-link-accent"/>
            </HBox>

            <Region prefHeight="20"/>

            <Label fx:id="statusMessageLabel" text="" wrapText="true"
                   maxWidth="400" styleClass="auth-status-msg" visible="false" managed="false"/>
        </VBox>
    </VBox>

</HBox>

