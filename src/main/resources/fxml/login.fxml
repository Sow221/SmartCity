<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartcity.controller.LoginController"
            prefWidth="800" prefHeight="500"
            style="-fx-background-color: #F5F5F5; -fx-font-family: 'Segoe UI', Arial, sans-serif;">

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
                <StackPane style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);">
                    <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 0 15 0 15;">
                        <Label text="SmartCity" style="-fx-font-size: 24; -fx-text-fill: #212121; -fx-font-weight: bold;" />
                        <Label text="Connexion" style="-fx-font-size: 18; -fx-text-fill: #212121;" />

                        <VBox spacing="15" alignment="CENTER">
                            <Label text="Email" style="-fx-font-size: 14; -fx-text-fill: #212121;" />
                            <TextField fx:id="emailField"
                                       promptText="exemple@email.com"
                                       prefWidth="250"
                                       prefHeight="35"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(33,33,33,0.2); -fx-font-size: 14; -fx-font-family: 'Segoe UI';" />

                            <Label text="Mot de passe" style="-fx-font-size: 14; -fx-text-fill: #212121;" />
                            <PasswordField fx:id="motPasseField"
                                           promptText="********"
                                           prefWidth="250"
                                           prefHeight="35"
                                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(33,33,33,0.2); -fx-font-size: 14; -fx-font-family: 'Segoe UI';" />
                        </VBox>

                        <Button fx:id="connexionButton"
                                text="Se connecter"
                                prefWidth="200"
                                prefHeight="40"
                                style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8;" />

                        <VBox spacing="5" alignment="CENTER">
                            <Hyperlink fx:id="forgotPasswordLink"
                                       text="Mot de passe oublié ?"
                                       style="-fx-text-fill: #212121;" />
                            <Hyperlink fx:id="createAccountLink"
                                       text="Créer un compte"
                                       style="-fx-text-fill: #2E7D32; -fx-font-weight: bold;" />
                        </VBox>

                        <Label fx:id="statusMessageLabel"
                               text=""
                               wrapText="true"
                               maxWidth="250"
                               style="-fx-font-size: 12; -fx-text-alignment: center;"
                               visible="false" />
                    </VBox>
                </StackPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
