<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartcity.controller.RegisterController"
            prefWidth="800" prefHeight="700"
            stylesheets="@../css/design-system.css"
            styleClass="auth-root">

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="16">
                
                <!-- Titre avec logo -->
                <Label text="🏙️ SMARTCITY" styleClass="auth-title"/>
                
                <!-- Sous-titre -->
                <Label text="Créer un compte" styleClass="auth-subtitle"/>
                
                <!-- Carte flottante blanche -->
                <VBox alignment="CENTER" spacing="10" styleClass="auth-card">
                    
                    <!-- Nom -->
                    <Label text="Nom complet" styleClass="form-label"/>
                    <TextField fx:id="nomField"
                               promptText="Votre nom complet"
                               prefWidth="320"
                               prefHeight="48"
                               styleClass="auth-input"/>
                    
                    <!-- Email -->
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="emailField"
                               promptText="exemple@email.com"
                               prefWidth="320"
                               prefHeight="48"
                               styleClass="auth-input"/>
                    
                    <!-- Zone -->
                    <Label text="Zone" styleClass="form-label"/>
                    <ComboBox fx:id="zoneCombo"
                              prefWidth="320"
                              prefHeight="48"
                              styleClass="combo-box"/>
                    
                    <!-- Mot de passe -->
                    <Label text="Mot de passe" styleClass="form-label"/>
                    <PasswordField fx:id="motPasseField"
                                   promptText="Minimum 6 caractères"
                                   prefWidth="320"
                                   prefHeight="48"
                                   styleClass="auth-input"/>
                    
                    <!-- Confirmer mot de passe -->
                    <Label text="Confirmer le mot de passe" styleClass="form-label"/>
                    <PasswordField fx:id="confirmField"
                                   promptText="Confirmez votre mot de passe"
                                   prefWidth="320"
                                   prefHeight="48"
                                   styleClass="auth-input"/>
                    
                    <!-- Espace -->
                    <StackPane prefHeight="12"/>
                    
                    <!-- Bouton S'inscrire -->
                    <Button fx:id="inscriptionButton"
                            text="S'INSCRIRE"
                            prefWidth="320"
                            prefHeight="50"
                            onAction="#handleInscription"
                            styleClass="auth-button"/>
                    
                    <!-- Lien retour -->
                    <Hyperlink fx:id="backToLoginLink"
                               text="← Retour à la connexion"
                               styleClass="auth-link"/>
                    
                    <!-- Message de statut -->
                    <Label fx:id="statusMessageLabel"
                           text=""
                           wrapText="true"
                           maxWidth="320"
                           styleClass="text-sm"
                           visible="false"/>
                    
                </VBox>
                
                <!-- Footer -->
                <Label text="© 2026 SmartCity - Pikine &amp; Guédiawaye" styleClass="auth-footer"/>
                
            </VBox>
        </StackPane>
    </center>
</BorderPane>
