<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartcity.controller.RegisterRoleComboController" spacing="16" alignment="TOP_LEFT" maxWidth="420">
    <padding><Insets left="40" right="40"/></padding>

    <!-- Rôle -->
    <VBox spacing="6">
        <Label text="Rôle" styleClass="auth-field-label"/>
        <ComboBox fx:id="roleCombo" prefHeight="50" promptText="Sélectionnez un rôle" styleClass="auth-field-combo">
            <items>
                <fx:string fx:value="CITOYEN"/>
                <fx:string fx:value="AGENT"/>
            </items>
        </ComboBox>
    </VBox>

</VBox>
