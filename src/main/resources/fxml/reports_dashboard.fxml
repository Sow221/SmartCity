<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="com.smartcity.controller.ReportsController"
            stylesheets="@../css/design-system.css"
            styleClass="app-root"
            prefWidth="1200" prefHeight="760"
            minWidth="960" minHeight="620">

    <!-- ═══ BARRE DE CONTROLES ═══ -->
    <top>
        <VBox styleClass="reports-header" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 12 20 10 20;">
                <StackPane styleClass="header-logo-badge" alignment="CENTER">
                    <Label text="SC" styleClass="header-logo-text" style="-fx-text-fill:#14532d;"/>
                </StackPane>
                <Label text="Rapports" styleClass="reports-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Du" styleClass="form-label"/>
                <DatePicker fx:id="startDatePicker" prefWidth="130"/>
                <Label text="au" styleClass="text-muted"/>
                <DatePicker fx:id="endDatePicker" prefWidth="130"/>
                <ComboBox fx:id="zoneFilterCombo" prefWidth="160" promptText="Toutes les zones"/>
                <ComboBox fx:id="reportTypeCombo" prefWidth="190"/>
                <Button fx:id="generateReportButton" text="Générer" onAction="#generateReport"
                        styleClass="action-button" prefHeight="36"/>
                <Button fx:id="exportReportButton" text="Exporter PDF" onAction="#exportReport"
                        styleClass="btn-outline-sm" prefHeight="36"/>
                <Button text="Retour" onAction="#handleBackToAdmin"
                        styleClass="btn-outline-sm" prefHeight="36"/>
            </HBox>

            <!-- ═══ ZONE 1 : 4 KPI ═══ -->
            <HBox spacing="10" style="-fx-padding: 0 20 12 20;">
                <VBox styleClass="rpt-kpi-card" HBox.hgrow="ALWAYS" spacing="3">
                    <Label text="TOTAL SIGNALEMENTS" styleClass="rpt-kpi-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="kpiTotal" text="-" styleClass="rpt-kpi-value"/>
                        <Label fx:id="kpiTotalDelta" text="" styleClass="rpt-kpi-delta-neutral"/>
                    </HBox>
                    <Label fx:id="kpiTotalSub" text="vs semaine précédente" styleClass="rpt-kpi-sub"/>
                </VBox>
                <VBox styleClass="rpt-kpi-card" HBox.hgrow="ALWAYS" spacing="3">
                    <Label text="TAUX DE RÉSOLUTION" styleClass="rpt-kpi-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="kpiTaux" text="-" styleClass="rpt-kpi-value"/>
                        <Label fx:id="kpiTauxDelta" text="" styleClass="rpt-kpi-delta-neutral"/>
                    </HBox>
                    <Label fx:id="kpiTauxSub" text="objectif ≥ 70%" styleClass="rpt-kpi-sub"/>
                </VBox>
                <VBox styleClass="rpt-kpi-card" HBox.hgrow="ALWAYS" spacing="3">
                    <Label text="DÉLAI MOYEN" styleClass="rpt-kpi-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="kpiDelai" text="-" styleClass="rpt-kpi-value"/>
                        <Label fx:id="kpiDelaiDelta" text="" styleClass="rpt-kpi-delta-neutral"/>
                    </HBox>
                    <Label fx:id="kpiDelaiSub" text="seuil critique : 48h" styleClass="rpt-kpi-sub"/>
                </VBox>
                <VBox styleClass="rpt-kpi-card rpt-kpi-card-alert" HBox.hgrow="ALWAYS" spacing="3">
                    <Label text="URGENTS +24h" styleClass="rpt-kpi-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="kpiUrgents" text="-" styleClass="rpt-kpi-value"/>
                        <Label fx:id="kpiUrgentsStatus" text="" styleClass="rpt-kpi-delta-neutral"/>
                    </HBox>
                    <Label text="action immédiate requise" styleClass="rpt-kpi-sub"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- ═══ ZONE 2 : GRAPHIQUES + PRIORITÉS ═══ -->
    <center>
        <VBox spacing="10" style="-fx-padding: 10 14 0 14;">
            <SplitPane dividerPositions="0.55" orientation="HORIZONTAL" VBox.vgrow="ALWAYS">

                <!-- Colonne gauche : graphiques -->
                <VBox spacing="10">
                    <HBox spacing="10" VBox.vgrow="ALWAYS">
                        <VBox styleClass="rpt-chart-card" HBox.hgrow="ALWAYS" spacing="4">
                            <Label text="Répartition par statut" styleClass="reports-section-title"/>
                            <PieChart fx:id="statusPieChart" VBox.vgrow="ALWAYS" prefHeight="210"
                                      legendVisible="true" labelsVisible="false"/>
                        </VBox>
                        <VBox styleClass="rpt-chart-card" HBox.hgrow="ALWAYS" spacing="4">
                            <Label text="Signalements par zone" styleClass="reports-section-title"/>
                            <BarChart fx:id="zoneBarChart" VBox.vgrow="ALWAYS" prefHeight="210"
                                      animated="false" legendVisible="false">
                                <xAxis><CategoryAxis fx:id="zoneXAxis"/></xAxis>
                                <yAxis><NumberAxis fx:id="zoneYAxis"/></yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>

                    <!-- Tendances -->
                    <VBox styleClass="rpt-chart-card" spacing="4">
                        <Label text="Tendances" styleClass="reports-section-title"/>
                        <LineChart fx:id="trendLineChart" VBox.vgrow="ALWAYS" prefHeight="160"
                                   animated="false" legendVisible="true">
                            <xAxis><CategoryAxis fx:id="trendXAxis"/></xAxis>
                            <yAxis><NumberAxis fx:id="trendYAxis"/></yAxis>
                        </LineChart>
                    </VBox>

                    <!-- Recommandations -->
                    <VBox styleClass="rpt-chart-card" spacing="8">
                        <Label text="Recommandations" styleClass="reports-section-title"/>
                        <VBox fx:id="recoContainer" spacing="6"/>
                    </VBox>
                </VBox>

                <!-- Colonne droite : top priorités -->
                <VBox spacing="10">
                    <VBox styleClass="rpt-chart-card" VBox.vgrow="ALWAYS" spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Top priorités d'action" styleClass="reports-section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="exportStatusLabel" text="" styleClass="rpt-kpi-sub"/>
                        </HBox>
                        <TableView fx:id="prioritiesTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="priorityIdColumn" text="ID" prefWidth="45"/>
                                <TableColumn fx:id="priorityZoneColumn" text="Zone" prefWidth="90"/>
                                <TableColumn fx:id="priorityAgeColumn" text="Âge (h)" prefWidth="70"/>
                                <TableColumn fx:id="priorityStatusColumn" text="Statut" prefWidth="90"/>
                                <TableColumn fx:id="priorityAgentColumn" text="Agent" prefWidth="110"/>
                                <TableColumn fx:id="priorityActionColumn" text="Priorité" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="Générez un rapport pour voir les priorités" styleClass="text-muted"/>
                            </placeholder>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT">
                            <Button text="Exporter CSV" onAction="#exportCsv"
                                    styleClass="btn-outline-sm" prefHeight="32"/>
                        </HBox>
                    </VBox>

                    <!-- statsTable caché - requis par le contrôleur -->
                    <TableView fx:id="statsTable" visible="false" managed="false" prefHeight="0">
                        <columns>
                            <TableColumn fx:id="metricColumn" text="Indicateur" prefWidth="165"/>
                            <TableColumn fx:id="valueColumn" text="Valeur" prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>

            </SplitPane>
        </VBox>
    </center>

    <!-- ═══ PIED DE PAGE ═══ -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="reports-footer">
            <Label fx:id="lastRefreshLabel" text="" styleClass="reports-hint"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="SmartCity — Pikine &amp; Guediawaye" styleClass="text-muted"/>
        </HBox>
    </bottom>

</BorderPane>
