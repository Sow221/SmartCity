<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartcity.controller.DashboardController">
    <top>
        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #27ae60;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <Label text="Tableau de bord - Agent de collecte" textFill="white">
                <font>
                    <Font size="20.0" />
                </font>
            </Label>
            <Button text="Déconnexion" onAction="#handleDeconnexion" />
        </VBox>
    </top>

    <center>
        <VBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <Label text="Signalements de ma zone">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>

            <TableView fx:id="tableSignalements" prefHeight="300.0">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="200.0" />
                    <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="100.0" />
                    <TableColumn fx:id="colZone" text="Zone" prefWidth="100.0" />
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="100.0" />
                </columns>
            </TableView>

            <Button text="Rafraîchir" onAction="#chargerDonnees" />
        </VBox>
    </center>
</BorderPane>

