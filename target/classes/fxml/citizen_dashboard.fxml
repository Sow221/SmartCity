<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartcity.controller.DashboardController"
            prefWidth="1000" prefHeight="700"
            style="-fx-background-color: #f0fdf4;">

    <!-- En-tête -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #ffffff; -fx-padding: 15 30 15 30;">
            <effect>
                <DropShadow color="rgba(0,0,0,0.1)" radius="5" blurType="GAUSSIAN"/>
            </effect>
            <Label text="🏙️ SMARTCITY" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1f2937;">
                <font>
                    <Font name="Segoe UI Bold" size="22"/>
                </font>
            </Label>
            <StackPane HBox.hgrow="ALWAYS"/>
            <Label text="Tableau de bord - Citoyen" style="-fx-font-size: 18; -fx-text-fill: #4b5563;">
                <font>
                    <Font name="Segoe UI" size="18"/>
                </font>
            </Label>
            <StackPane HBox.hgrow="ALWAYS"/>
            <Button fx:id="deconnexionButton"
                    text="Déconnexion"
                    onAction="#handleDeconnexion"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 20 10 20;">
                <font>
                    <Font name="Segoe UI" size="14"/>
                </font>
            </Button>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <StackPane>
            <padding>
                <Insets bottom="30" left="30" right="30" top="30"/>
            </padding>
            
            <VBox spacing="20">
                
                <!-- Titre -->
                <Label text="Mes signalements de déchets" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1f2937;">
                    <font>
                        <Font name="Segoe UI Bold" size="24"/>
                    </font>
                </Label>
                
                <!-- Tableau -->
                <StackPane style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-padding: 20;">
                    <effect>
                        <DropShadow color="rgba(0,0,0,0.1)" radius="10" blurType="GAUSSIAN"/>
                    </effect>
                    
                    <TableView fx:id="tableSignalements" prefHeight="400" style="-fx-background-radius: 12; -fx-background-color: #ffffff;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="60">
                                <style>
                                    -fx-font-size: 14; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-text-fill: #4b5563;
                                </style>
                            </TableColumn>
                            <TableColumn fx:id="colDescription" text="Description" prefWidth="250">
                                <style>
                                    -fx-font-size: 14; -fx-font-family: 'Segoe UI';
                                </style>
                            </TableColumn>
                            <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="120">
                                <style>
                                    -fx-font-size: 14; -fx-font-family: 'Segoe UI';
                                </style>
                            </TableColumn>
                            <TableColumn fx:id="colZone" text="Zone" prefWidth="120">
                                <style>
                                    -fx-font-size: 14; -fx-font-family: 'Segoe UI';
                                </style>
                            </TableColumn>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120">
                                <style>
                                    -fx-font-size: 14; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;
                                </style>
                            </TableColumn>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="150">
                                <style>
                                    -fx-font-size: 14; -fx-font-family: 'Segoe UI';
                                </style>
                            </TableColumn>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </StackPane>
                
                <!-- Boutons d'action -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button fx:id="rafraichirButton"
                            text="🔄 Rafraîchir"
                            onAction="#chargerDonnees"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 12 25 12 25;">
                        <font>
                            <Font name="Segoe UI" size="14"/>
                        </font>
                    </Button>
                    
                    <Button fx:id="nouveauSignalementButton"
                            text="➕ Nouveau signalement"
                            onAction="#handleNouveauSignalement"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 12 25 12 25;">
                        <font>
                            <Font name="Segoe UI" size="14"/>
                        </font>
                    </Button>
                </HBox>
                
            </VBox>
        </StackPane>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 10;">
            <Label text="© 2026 SmartCity - Gestion des déchets à Pikine &amp; Guédiawaye" style="-fx-font-size: 12; -fx-text-fill: #9ca3af;">
                <font>
                    <Font name="Segoe UI" size="12"/>
                </font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
