<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartcity.controller.LoginController"
      prefWidth="1000" prefHeight="620"
      minWidth="720" minHeight="520"
      stylesheets="@../css/design-system.css"
      styleClass="auth-root-split">

    <!-- ═══════════════════════════════════════════════════════
         PANNEAU GAUCHE — Branding
    ═══════════════════════════════════════════════════════ -->
    <StackPane prefWidth="400" minWidth="300" maxWidth="420">

        <!-- Fond dégradé -->
        <VBox styleClass="auth-brand-panel" alignment="CENTER" spacing="0"/>

        <!-- Cercles décoratifs -->
        <StackPane styleClass="auth-deco-circle-1" alignment="CENTER"/>
        <StackPane styleClass="auth-deco-circle-2" alignment="CENTER"/>
        <StackPane styleClass="auth-deco-circle-3" alignment="CENTER"/>

        <!-- Contenu par-dessus -->
        <VBox alignment="CENTER" spacing="0">

            <VBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">
                <padding><Insets top="64" right="44" bottom="0" left="44"/></padding>

                <!-- ── Logo monogramme SC (CSS pur, sans image) ── -->
                <StackPane fx:id="logoPane" alignment="CENTER">
                    <StackPane styleClass="auth-logo-ring-outer" alignment="CENTER">
                        <StackPane styleClass="auth-logo-ring-inner" alignment="CENTER">
                            <!-- Monogramme SC -->
                            <VBox alignment="CENTER" spacing="-4">
                                <Label text="SC" styleClass="auth-logo-monogram"/>
                                <Label text="SMART" styleClass="auth-logo-wordmark"/>
                            </VBox>
                        </StackPane>
                    </StackPane>
                </StackPane>

                <!-- Nom + tagline -->
                <VBox fx:id="brandTitleBox" alignment="CENTER" spacing="6">
                    <Label text="SmartCity" styleClass="auth-brand-title"/>
                    <Label text="Gestion intelligente des déchets" styleClass="auth-brand-subtitle"/>
                </VBox>

                <!-- Divider -->
                <StackPane fx:id="brandDivider" prefHeight="1" maxWidth="48" styleClass="auth-brand-divider"/>

                <!-- Features — icônes Unicode universelles -->
                <VBox spacing="16" alignment="CENTER_LEFT" maxWidth="270">

                    <HBox fx:id="feature1" spacing="14" alignment="CENTER_LEFT">
                        <StackPane styleClass="auth-feature-badge" alignment="CENTER">
                            <Label text="📍" styleClass="auth-feature-icon"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label text="Carte interactive" styleClass="auth-feature-title"/>
                            <Label text="Pikine &amp; Guédiawaye en temps réel" styleClass="auth-feature-desc"/>
                        </VBox>
                    </HBox>

                    <HBox fx:id="feature2" spacing="14" alignment="CENTER_LEFT">
                        <StackPane styleClass="auth-feature-badge" alignment="CENTER">
                            <Label text="📊" styleClass="auth-feature-icon"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label text="Statistiques &amp; rapports" styleClass="auth-feature-title"/>
                            <Label text="Suivi par zone, statut et catégorie" styleClass="auth-feature-desc"/>
                        </VBox>
                    </HBox>

                    <HBox fx:id="feature3" spacing="14" alignment="CENTER_LEFT">
                        <StackPane styleClass="auth-feature-badge" alignment="CENTER">
                            <Label text="🔒" styleClass="auth-feature-icon"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label text="Accès sécurisé par rôle" styleClass="auth-feature-title"/>
                            <Label text="Admin · Agent · Citoyen" styleClass="auth-feature-desc"/>
                        </VBox>
                    </HBox>

                </VBox>
            </VBox>

            <!-- Footer -->
            <VBox fx:id="brandFooter" alignment="CENTER">
                <padding><Insets top="0" bottom="28"/></padding>
                <Label text="© 2026 SmartCity — Pikine &amp; Guédiawaye, Sénégal" styleClass="auth-brand-footer"/>
            </VBox>

        </VBox>
    </StackPane>

    <!-- ═══════════════════════════════════════════════════════
         PANNEAU DROIT — Formulaire connexion
    ═══════════════════════════════════════════════════════ -->
    <VBox styleClass="auth-form-panel" HBox.hgrow="ALWAYS" alignment="CENTER">

        <VBox alignment="TOP_LEFT" spacing="0" maxWidth="420">
            <padding><Insets left="40" right="40"/></padding>

            <!-- En-tête formulaire -->
            <Label fx:id="formTitle" text="Connexion à votre espace" styleClass="auth-form-title"/>
            <Region prefHeight="8"/>
            <Label fx:id="formSubtitle" text="Entrez vos identifiants pour accéder à SmartCity" styleClass="auth-form-subtitle"/>
            <Region prefHeight="32"/>

            <!-- Champ Email -->
            <VBox fx:id="emailGroup" spacing="0">
                <Label text="Adresse email" styleClass="auth-field-label"/>
                <Region prefHeight="8"/>
                <TextField fx:id="emailField"
                           promptText="exemple@email.com"
                           maxWidth="Infinity" prefHeight="50"
                           styleClass="auth-field"/>
                <Label fx:id="emailErrorLabel" text="" styleClass="auth-field-error-label"
                       visible="false" managed="false"/>
            </VBox>
            <Region prefHeight="16"/>

            <!-- Champ Mot de passe -->
            <VBox fx:id="passwordGroup" spacing="0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Mot de passe" styleClass="auth-field-label" HBox.hgrow="ALWAYS"/>
                    <Hyperlink fx:id="forgotPasswordLink" text="Mot de passe oublié ?" styleClass="auth-link-forgot"/>
                </HBox>
                <Region prefHeight="8"/>
                <StackPane>
                    <PasswordField fx:id="motPasseField"
                                   promptText="••••••••"
                                   maxWidth="Infinity" prefHeight="50"
                                   styleClass="auth-field"/>
                    <TextField fx:id="motPasseVisible"
                               promptText="••••••••"
                               maxWidth="Infinity" prefHeight="50"
                               styleClass="auth-field"
                               visible="false" managed="false"/>
                    <Button fx:id="togglePasswordBtn" text="👁"
                            StackPane.alignment="CENTER_RIGHT"
                            styleClass="auth-toggle-pwd-btn"
                            onAction="#handleTogglePassword">
                        <tooltip><Tooltip text="Afficher / masquer le mot de passe"/></tooltip>
                    </Button>
                </StackPane>
                <Label fx:id="passwordErrorLabel" text="" styleClass="auth-field-error-label"
                       visible="false" managed="false"/>
            </VBox>
            <Region prefHeight="24"/>

            <!-- Bouton principal -->
            <Button fx:id="connexionButton"
                    text="Se connecter"
                    maxWidth="Infinity" prefHeight="50"
                    onAction="#handleConnexion"
                    styleClass="auth-submit-btn"/>

            <Region prefHeight="20"/>

            <!-- Indicateur sécurité -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="Connexion chiffrée et sécurisée" styleClass="auth-security-hint"/>
            </HBox>

            <Region prefHeight="12"/>

            <!-- Lien inscription -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Pas encore de compte ?" styleClass="auth-hint-label"/>
                <Hyperlink text="S'inscrire →" styleClass="auth-link-accent" onAction="#handleGoToRegister"/>
            </HBox>

            <Region prefHeight="12"/>

            <!-- Message statut -->
            <Label fx:id="statusMessageLabel" text="" wrapText="true"
                   maxWidth="380" styleClass="auth-status-msg" visible="false"/>

        </VBox>
    </VBox>

</HBox>
