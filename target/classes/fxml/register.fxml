<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartcity.controller.RegisterController"
            prefWidth="800"
            prefHeight="500"
            style="-fx-background-color: #F5F5F5; -fx-font-family: 'Segoe UI', Arial, sans-serif;">

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
                <VBox alignment="CENTER" spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.14), 22, 0, 0, 12);">
                    <Label text="Créer un compte"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #212121;" />
                    <Label text="Rejoignez SmartCity et commencez à signaler les déchets autour de vous."
                           wrapText="true"
                           style="-fx-font-size: 14; -fx-text-fill: #212121; -fx-text-alignment: center;" />

                    <GridPane hgap="10" vgap="10" style="-fx-padding: 10 0 0 0;">

                        <Label text="Nom complet"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"
                               style="-fx-text-fill: #212121; -fx-font-size: 14;" />
                        <TextField fx:id="nomField"
                                   promptText="Votre nom complet"
                                   prefWidth="300"
                                   prefHeight="35"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(33,33,33,0.2); -fx-font-size: 14;" />

                        <Label text="Email"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2"
                               style="-fx-text-fill: #212121; -fx-font-size: 14;" />
                        <TextField fx:id="emailField"
                                   promptText="exemple@email.com"
                                   prefWidth="300"
                                   prefHeight="35"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="3"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(33,33,33,0.2); -fx-font-size: 14;" />

                        <Label text="Téléphone (optionnel)"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="4"
                               style="-fx-text-fill: #212121; -fx-font-size: 14;" />
                        <TextField fx:id="telephoneField"
                                   promptText="+221 77 123 45 67"
                                   prefWidth="300"
                                   prefHeight="35"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="5"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(33,33,33,0.2); -fx-font-size: 14;" />

                        <Label text="Mot de passe"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="6"
                               style="-fx-text-fill: #212121; -fx-font-size: 14;" />
                        <PasswordField fx:id="motPasseField"
                                       promptText="Minimum 6 caractères"
                                       prefWidth="300"
                                       prefHeight="35"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="7"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(33,33,33,0.2); -fx-font-size: 14;" />

                        <Label text="Confirmer le mot de passe"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="8"
                               style="-fx-text-fill: #212121; -fx-font-size: 14;" />
                        <PasswordField fx:id="confirmField"
                                       promptText="Confirmez le mot de passe"
                                       prefWidth="300"
                                       prefHeight="35"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="9"
                                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(33,33,33,0.2); -fx-font-size: 14;" />

                        <Label text="Zone"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="10"
                               style="-fx-text-fill: #212121; -fx-font-size: 14;" />
                        <ComboBox fx:id="zoneCombo"
                                  promptText="Sélectionnez une zone"
                                  prefWidth="300"
                                  prefHeight="35"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="11"
                                  style="-fx-background-radius: 8; -fx-border-radius: 8;" />

                        <Label text="Rôle (admin uniquement)"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="12"
                               style="-fx-text-fill: #212121; -fx-font-size: 14;" />
                        <ComboBox fx:id="roleCombo"
                                  promptText="Citoyen"
                                  prefWidth="300"
                                  prefHeight="35"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="13"
                                  style="-fx-background-radius: 8; -fx-border-radius: 8;"
                                  disable="true" />
                    </GridPane>

                    <Button text="S'inscrire"
                            fx:id="inscriptionButton"
                            onAction="#handleInscription"
                            prefWidth="220"
                            prefHeight="40"
                            style="-fx-background-color: #66BB6A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />

                    <Label fx:id="statusMessageLabel"
                           text=""
                           wrapText="true"
                           maxWidth="260"
                           style="-fx-font-size: 12; -fx-text-alignment: center;"
                           visible="false" />

                    <Hyperlink fx:id="backToLoginLink"
                               text="Déjà un compte ? Connexion"
                               style="-fx-text-fill: #212121; -fx-underline: false;" />
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
