<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartcity.controller.RegisterController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="SmartCity - Inscription">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <GridPane hgap="10.0" vgap="10.0">
        <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="nomField" promptText="Entrez votre nom" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="emailField" promptText="Entrez votre email" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Mot de passe:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <PasswordField fx:id="motPasseField" promptText="Entrez votre mot de passe" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Rôle:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="roleCombo" promptText="Sélectionnez un rôle" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Zone:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <ComboBox fx:id="zoneCombo" promptText="Sélectionnez une zone" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>

    <Button text="S'inscrire" onAction="#handleInscription" prefWidth="200.0" />
    <Button text="Retour" onAction="#handleRetour" prefWidth="200.0" style="-fx-background-color: transparent; -fx-text-fill: #0066cc;" />
</VBox>

